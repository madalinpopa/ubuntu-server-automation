# {{ ansible_managed }}
# Caddy configuration. Docs: https://caddyserver.com/docs/caddyfile
{% if caddy_local_certs | bool %}

# Test mode: certificates come from Caddy's own local authority instead of
# Let's Encrypt. Browsers do not trust them.
{
	local_certs
	skip_install_trust
}
{% endif %}

{{ caddy_site_address }} {
	root * /var/www/html
	file_server
}

# One file per service site, for example sites/gitea.caddy. playbooks/services.yml
# writes each file only after the service's admin account is set up.
import /etc/caddy/sites/*.caddy
